<?xml version="1.0" encoding="utf-8"?>
<!-- Sky Agentic AI Launcher Icon Vector Graphic -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Deep Space Background Disc -->
    <path
        android:pathData="M 0 0 H 108 V 108 H 0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="65"
                android:startColor="#152442"
                android:endColor="#070A12" />
        </aapt:attr>
    </path>

    <!-- Outer Orbital Cyan Glow Ring -->
    <path
        android:pathData="M 54,18 A 36,36 0 1 1 53.9,18 Z"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.4">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90"
                android:startColor="#00F0FF"
                android:endColor="#3B82F6" />
        </aapt:attr>
    </path>

    <!-- Planetary Orbital Ellipse 1 (Cyan to Deep Azure) -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-25">
        <path
            android:pathData="M 54,26 A 28,12 0 1 1 53.9,26 Z"
            android:strokeWidth="2.8"
            android:strokeAlpha="0.9">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="26"
                    android:startY="26"
                    android:endX="82"
                    android:endY="82"
                    android:startColor="#00F0FF"
                    android:endColor="#0284C7" />
            </aapt:attr>
        </path>
    </group>

    <!-- Planetary Orbital Ellipse 2 (Neon Blue to Violet) -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="35">
        <path
            android:pathData="M 54,28 A 26,10 0 1 1 53.9,28 Z"
            android:strokeWidth="2.2"
            android:strokeAlpha="0.85">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="28"
                    android:startY="28"
                    android:endX="80"
                    android:endY="80"
                    android:startColor="#38BDF8"
                    android:endColor="#6366F1" />
            </aapt:attr>
        </path>
    </group>

    <!-- Central Sky AI Sphere Glow Halo -->
    <path
        android:pathData="M 54,34 A 20,20 0 1 1 53.9,34 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="22"
                android:startColor="#3300F0FF"
                android:endColor="#000284C7" />
        </aapt:attr>
    </path>

    <!-- Central Sky Core Core Orb -->
    <path
        android:pathData="M 54,39 A 15,15 0 1 1 53.9,39 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="39"
                android:startY="39"
                android:endX="69"
                android:endY="69"
                android:startColor="#E0F7FE"
                android:centerColor="#00C2FF"
                android:endColor="#1D4ED8" />
        </aapt:attr>
    </path>

    <!-- Stylized 'S' AI Wave Ribbon inside Core -->
    <path
        android:pathData="M 48,46 C 51,43 57,43 60,46 C 63,49 57,53 54,54 C 51,55 45,59 48,62 C 51,65 57,65 60,62"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="45"
                android:startY="43"
                android:endX="63"
                android:endY="65"
                android:startColor="#FFFFFF"
                android:endColor="#BAE6FD" />
        </aapt:attr>
    </path>

    <!-- Orbital Satellite Particle (Top Right) -->
    <path
        android:pathData="M 74,38 A 3,3 0 1 1 73.9,38 Z"
        android:fillColor="#00F0FF" />

    <!-- Orbital Satellite Particle (Bottom Left) -->
    <path
        android:pathData="M 33,68 A 2,2 0 1 1 32.9,68 Z"
        android:fillColor="#38BDF8" />
</vector>

